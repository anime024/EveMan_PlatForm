<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Favourite Photos</title>
    
    <style>
        *{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:#f8fafc;
    color:#1f2937;
}

.page-content{
    padding:90px 20px 30px;
}

.container{
    max-width:1200px;
    margin:0 auto;
}

header{
    text-align:center;
    margin-bottom:35px;
}

header h1{
    font-size:2.2rem;
    margin-bottom:10px;
    color:#111827;
}

header p{
    color:#6b7280;
}

.gallery-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(300px,1fr));
    gap:24px;
}

.photo-card{
    background:white;
    border:1px solid #e5e7eb;
    border-radius:14px;
    overflow:hidden;
    transition:0.2s;
}

.photo-card:hover{
    transform:translateY(-3px);
    box-shadow:0 10px 25px rgba(0,0,0,0.08);
}

.image-wrapper{
    width:100%;
    height:260px;
    overflow:hidden;
    background:#f3f4f6;
}

.image-wrapper img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:0.3s;
}

.photo-card:hover img{
    transform:scale(1.04);
}

.card-content{
    padding:18px;
}

.tag-container{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin-bottom:16px;
}

.tag{
    background:#f3f4f6;
    color:#4b5563;
    padding:5px 10px;
    border-radius:20px;
    font-size:12px;
}

.card-meta{
    display:flex;
    justify-content:space-between;
    align-items:center;
    border-top:1px solid #e5e7eb;
    padding-top:15px;
    color:#6b7280;
    font-size:14px;
}

.btn-view{
    text-decoration:none;
    background:#111827;
    color:white;
    padding:8px 14px;
    border-radius:8px;
    transition:0.2s;
}

.btn-view:hover{
    background:#374151;
}

.empty-state{
    text-align:center;
    background:white;
    border:1px solid #e5e7eb;
    border-radius:14px;
    padding:70px 20px;
}

.empty-state h3{
    margin:15px 0 10px;
    color:#111827;
}

.empty-state p{
    color:#6b7280;
    margin-bottom:25px;
}

.btn-browse{
    text-decoration:none;
    background:#2563eb;
    color:white;
    padding:12px 18px;
    border-radius:10px;
}

.btn-browse:hover{
    background:#1d4ed8;
}

@media(max-width:768px){

    .page-content{
        padding:80px 15px 20px;
    }

    header h1{
        font-size:1.8rem;
    }

    .card-meta{
        flex-direction:column;
        gap:12px;
        align-items:flex-start;
    }
}
    </style>
</head>
<body>

    <%- include('partials/navbar') %>

    <div class="page-content">

        <div class="container">
        <header>
            <h1>My Favourite Photos</h1>
            <p>A collection of your favorite captured moments</p>
        </header>

        <% if (media && media.length > 0) { %>
            <div class="gallery-grid">
                <% media.forEach(item => { %>
                    <div class="photo-card">
                        <div class="image-wrapper">
                            <img src="<%= item.url %>" alt="Favourite Photo">
                        </div>
                        
                        <div class="card-content">
                            <% if (item.tags && item.tags.length > 0) { %>
                                <div class="tag-container">
                                    <% item.tags.forEach(tag => { %>
                                        <span class="tag">#<%= tag %></span>
                                    <% }) %>
                                </div>
                            <% } %>

                            <div class="card-meta">
                                <span><%= item.likes ? item.likes.length : 0 %> Likes</span>
                                <a href="/media/<%= item._id %>" class="btn-view">View Post</a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="empty-state">
                <span style="font-size: 4rem;">📸</span>
                <h3>No favorites saved yet</h3>
                <p>Explore the events and tap the favorite button on photos you love!</p>
                <a href="/event" class="btn-browse">Browse Events</a>
            </div>
        <% } %>
            </div>

    </div>

</body>
</html>