<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Events</title>

<style>
 *{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:#f8fafc;
    color:#222;
}

.container{
    width:92%;
    max-width:1200px;
    margin:30px auto;
}

h1{
    text-align:center;
    margin-bottom:25px;
    font-size:32px;
    color:#1f2937;
}

.message{
    background:#dcfce7;
    color:#166534;
    padding:14px;
    border-radius:10px;
    text-align:center;
    margin-bottom:20px;
}

.top-actions{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:15px;
    flex-wrap:wrap;
    margin-bottom:25px;
}

.create-btn{
    text-decoration:none;
    background:#2563eb;
    color:white;
    padding:12px 18px;
    border-radius:10px;
    font-weight:600;
    transition:0.2s;
}

.create-btn:hover{
    background:#1d4ed8;
}

.filters{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
}

select,
input{
    padding:12px;
    border:1px solid #d1d5db;
    border-radius:10px;
    outline:none;
}

input:focus,
select:focus{
    border-color:#2563eb;
}

button{
    border:none;
    background:#2563eb;
    color:white;
    padding:12px 18px;
    border-radius:10px;
    cursor:pointer;
    transition:0.2s;
}

button:hover{
    background:#1d4ed8;
}

.search-form{
    display:flex;
    gap:10px;
    margin-bottom:30px;
}

.search-form input{
    flex:1;
}

.events-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(320px,1fr));
    gap:20px;
}

.event-card{
    background:white;
    border:1px solid #e5e7eb;
    border-radius:14px;
    padding:20px;
    transition:0.2s;
}

.event-card:hover{
    transform:translateY(-3px);
    box-shadow:0 10px 25px rgba(0,0,0,0.08);
}

.event-title{
    font-size:22px;
    margin-bottom:10px;
    color:#111827;
}

.creator{
    color:#6b7280;
    font-size:14px;
    margin-bottom:12px;
}

.category{
    display:inline-block;
    background:#eff6ff;
    color:#2563eb;
    padding:6px 12px;
    border-radius:20px;
    font-size:13px;
    font-weight:600;
    margin-bottom:15px;
}

.description{
    color:#4b5563;
    line-height:1.6;
    margin-bottom:18px;
}

.view-btn{
    display:inline-block;
    text-decoration:none;
    background:#111827;
    color:white;
    padding:10px 16px;
    border-radius:8px;
    transition:0.2s;
}

.view-btn:hover{
    background:#374151;
}

.empty{
    text-align:center;
    margin-top:50px;
    color:#6b7280;
    font-size:18px;
}

@media(max-width:768px){

    h1{
        font-size:26px;
    }

    .top-actions{
        flex-direction:column;
        align-items:stretch;
    }

    .search-form{
        flex-direction:column;
    }

    .search-form button{
        width:100%;
    }

    .filters{
        width:100%;
    }

    .filters select,
    .filters button{
        width:100%;
    }

    .create-btn{
        text-align:center;
        width:100%;
    }
}
</style>


</head>
<body>


<%- include('../partials/navbar') %>

<div class="container">

    <% if(message){ %>
        <div class="message">
            <%= message %>
        </div>
    <% } %>

    <h1>All Events</h1>

    <div class="top-actions">

        <a href="/event/create" class="create-btn">
            + Create Event
        </a>

        <form action="/event" method="GET" class="filters">

            <select name="sort">

                <option value="">
                    Sort Events
                </option>

                <option value="newest">
                    Newest First
                </option>

                <option value="oldest">
                    Oldest First
                </option>

                <option value="category">
                    Category
                </option>

            </select>

            <button type="submit">
                Apply
            </button>

        </form>

    </div>

    <form action="/media/search" method="GET" class="search-form">

        <input
            type="text"
            name="q"
            placeholder="Search events, tags, users..."
            required
        >

        <button type="submit">
            Search
        </button>

    </form>

    <% if(allEvents.length === 0){ %>

        <div class="empty">
            No events found.
        </div>

    <% } else { %>

        <div class="events-grid">

            <% allEvents.forEach((event)=>{ %>

                <div class="event-card">

                    <h2 class="event-title">
                        <%= event.title %>
                    </h2>

                    <p class="creator">
                        Created by <strong><%= event.createdBy.name %></strong>
                    </p>

                    <span class="category">
                        <%= event.category %>
                    </span>

                    <p class="description">
                        <%= event.description %>
                    </p>

                    <a
                        href="/event/<%= event._id %>"
                        class="view-btn"
                    >
                        View Event
                    </a>

                </div>

            <% }) %>

        </div>

    <% } %>

</div>
```

</body>
</html>
