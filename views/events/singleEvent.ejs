<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= event.title %></title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:#f4f6f9;
}

.container{
    width:90%;
    max-width:1200px;
    margin:30px auto;
}

/* EVENT HEADER */

.event-card{
    background:white;
    border-radius:16px;
    padding:30px;
    box-shadow:0 5px 20px rgba(0,0,0,.08);
    margin-bottom:30px;
}

.event-title{
    font-size:2.2rem;
    margin-bottom:15px;
    color:#222;
}

.event-description{
    color:#555;
    line-height:1.7;
    margin-bottom:20px;
}

.event-meta{
    display:flex;
    flex-wrap:wrap;
    gap:12px;
}

.meta-badge{
    background:#e0e7ff;
    color:#4338ca;
    padding:8px 14px;
    border-radius:20px;
    font-size:14px;
    font-weight:600;
}


.actions{
    margin-top:25px;
    display:flex;
    gap:12px;
    flex-wrap:wrap;
}

.btn{
    text-decoration:none;
    border:none;
    cursor:pointer;
    background:#2563eb;
    color:white;
    padding:12px 18px;
    border-radius:8px;
    font-weight:600;
}

.btn-danger{
    background:#dc2626;
}

.btn-success{
    background:#16a34a;
}

.btn:hover{
    opacity:.9;
}

/* MEDIA SECTION */

.section-title{
    font-size:1.8rem;
    margin-bottom:20px;
    color:#222;
}


.gallery{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(280px,1fr));
    gap:20px;
}

.gallery-item{
    display:block;
    overflow:hidden;
    border-radius:12px;
    background:white;
    box-shadow:0 4px 15px rgba(0,0,0,.08);
    position:relative;
    height:280px;
    transition:.3s;
}

.gallery-item:hover{
    transform:translateY(-6px);
    box-shadow:0 10px 25px rgba(37,99,235,.15);
}

.gallery-item img,
.gallery-item video{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:.4s;
}

.gallery-item:hover img{
    transform:scale(1.05);
}

.video-badge{
    position:absolute;
    top:12px;
    right:12px;
    background:rgba(0,0,0,.75);
    color:white;
    padding:6px 10px;
    border-radius:6px;
    z-index:2;
    font-size:12px;
}


.empty{
    background:white;
    padding:50px;
    text-align:center;
    border-radius:16px;
    box-shadow:0 4px 15px rgba(0,0,0,.08);
}

.empty h3{
    margin-bottom:10px;
}

.empty p{
    color:#666;
}


.delete-form{
    display:inline;
}

@media(max-width:768px){

    .event-title{
        font-size:1.8rem;
    }

    .gallery{
        grid-template-columns:1fr;
    }

}

</style>

</head>

<body>

<%- include('../partials/navbar') %>

<div class="container">

<div class="event-card">

    <h1 class="event-title">
        <%= event.title %>
    </h1>

    <p class="event-description">
        <%= event.description %>
    </p>

    <div class="event-meta">

        <span class="meta-badge">
            👤 <%= event.createdBy.name %>
        </span>

        <span class="meta-badge">
            📂 <%= event.category %>
        </span>

        <span class="meta-badge">
            <% if(event.visibility === "public"){ %>
                🌍 Public
            <% } else { %>
                🔒 Private
            <% } %>
        </span>

        <span class="meta-badge">
            📅 <%= event.date.toDateString() %>
        </span>

        <span class="meta-badge">
            📸 <%= event.media ? event.media.length : 0 %> Media
        </span>

    </div>

    <% if(user.role === "admin" || event.createdBy._id.toString() === user._id.toString()){ %>

        <div class="actions">

            <a
                href="/event/edit/<%= event._id %>"
                class="btn"
            >
                Edit Event
            </a>

            <a
                href="/upload/single/<%= event._id %>"
                class="btn btn-success"
            >
                Upload Single Media
            </a>

            <a
                href="/upload/multiple/<%= event._id %>"
                class="btn btn-success"
            >
                Upload Multiple Media
            </a>

            <form
                action="/event/delete/<%= event._id %>"
                method="POST"
                class="delete-form"
            >
                <button
                    type="submit"
                    class="btn btn-danger"
                >
                    Delete Event
                </button>
            </form>

        </div>

    <% } %>

</div>

<h2 class="section-title">
    Event Gallery
</h2>

<% if(event.media && event.media.length > 0){ %>

    <div class="gallery">

        <% event.media.forEach(function(item){ %>

            <% if(item.url){ %>

                <% 
                const videoExtensions = ['.mp4','.webm','.ogg','.mov'];
                const isVideo = videoExtensions.some(ext =>
                    item.url.toLowerCase().endsWith(ext)
                );
                %>

                <a
                    href="/media/<%= item._id %>"
                    class="gallery-item"
                >

                    <% if(isVideo){ %>

                        <div class="video-badge">
                            ▶ Video
                        </div>

                        <video
                            src="<%= item.url %>"
                            muted
                            preload="metadata"
                        ></video>

                    <% } else { %>

                        <img
                            src="<%= item.url %>"
                            alt="Event Media"
                        >

                    <% } %>

                </a>

            <% } %>

        <% }) %>

    </div>

<% } else { %>

    <div class="empty">

        <h3>
            No Media Uploaded Yet
        </h3>

        <p>
            Upload photos and videos to start building this event gallery.
        </p>

    </div>

<% } %>

</div>

</body>
</html>
