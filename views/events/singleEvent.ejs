<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= event.title %></title>

<style>
    *{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:#f8fafc;
    color:#111827;
}

.page-content{
    padding:90px 20px 30px;
}

.container{
    width:100%;
    max-width:1200px;
    margin:auto;
}

/* EVENT SECTION */

.event-card{
    background:white;
    border:1px solid #e5e7eb;
    border-radius:16px;
    padding:30px;
    margin-bottom:35px;
}

.event-title{
    font-size:2rem;
    margin-bottom:15px;
}

.event-description{
    color:#6b7280;
    line-height:1.7;
    margin-bottom:20px;
}

.event-meta{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
}

.meta-badge{
    background:#f3f4f6;
    color:#374151;
    padding:8px 14px;
    border-radius:20px;
    font-size:14px;
}

/* ACTION BUTTONS */

.actions{
    display:flex;
    flex-wrap:wrap;
    gap:12px;
    margin-top:25px;
}

.btn{
    text-decoration:none;
    border:none;
    cursor:pointer;
    padding:11px 16px;
    border-radius:10px;
    color:white;
    font-weight:600;
    transition:.2s;
}

.btn:hover{
    opacity:.9;
}

.btn{
    background:#2563eb;
}

.btn-success{
    background:#16a34a;
}

.btn-danger{
    background:#dc2626;
}

/* GALLERY */

.section-title{
    font-size:1.7rem;
    margin-bottom:20px;
}

.gallery{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(280px,1fr));
    gap:20px;
}

.gallery-item{
    display:block;
    height:280px;
    overflow:hidden;
    border-radius:14px;
    background:white;
    border:1px solid #e5e7eb;
    position:relative;
    transition:.25s;
}

.gallery-item:hover{
    transform:translateY(-3px);
    box-shadow:0 10px 25px rgba(0,0,0,0.08);
}

.gallery-item img,
.gallery-item video{
    width:100%;
    height:100%;
    object-fit:cover;
}

.gallery-item img{
    transition:.3s;
}

.gallery-item:hover img{
    transform:scale(1.05);
}

.video-badge{
    position:absolute;
    top:10px;
    right:10px;
    background:rgba(0,0,0,.75);
    color:white;
    padding:5px 10px;
    border-radius:6px;
    font-size:12px;
    z-index:2;
}


.empty{
    background:white;
    border:1px solid #e5e7eb;
    border-radius:16px;
    text-align:center;
    padding:70px 20px;
}

.empty h3{
    margin-bottom:10px;
}

.empty p{
    color:#6b7280;
}

.delete-form{
    display:inline;
}

@media(max-width:768px){

    .page-content{
        padding:80px 15px 20px;
    }

    .event-title{
        font-size:1.6rem;
    }

    .gallery{
        grid-template-columns:1fr;
    }

    .actions{
        flex-direction:column;
    }

    .btn{
        width:100%;
        text-align:center;
    }
}
</style>

</head>

<body>

<header>
    <%- include('../partials/navbar') %>
</header>

<div class="page-content">

<div class="container">

<div class="event-card">

    <h1 class="event-title">
        <%= event.title %>
    </h1>

    <p class="event-description">
        <%= event.description %>
    </p>

    <div class="event-meta">

        <span class="meta-badge">
             <%= event.createdBy.name %>
        </span>

        <span class="meta-badge">
             <%= event.category %>
        </span>

        <span class="meta-badge">
            <% if(event.visibility === "public"){ %>
                 Public
            <% } else { %>
                 Private
            <% } %>
        </span>

        <span class="meta-badge">
            <%= event.date.toDateString() %>
        </span>

        <span class="meta-badge">
            <%= event.media ? event.media.length : 0 %> Media
        </span>

    </div>

    <% if(user.role === "admin" || event.createdBy._id.toString() === user._id.toString()){ %>

        <div class="actions">

            <a
                href="/event/edit/<%= event._id %>"
                class="btn"
            >
                Edit Event
            </a>

            <a
                href="/upload/single/<%= event._id %>"
                class="btn btn-success"
            >
                Upload Single Media
            </a>

            <a
                href="/upload/multiple/<%= event._id %>"
                class="btn btn-success"
            >
                Upload Multiple Media
            </a>

            <form
                action="/event/delete/<%= event._id %>"
                method="POST"
                class="delete-form"
            >
                <button
                    type="submit"
                    class="btn btn-danger"
                >
                    Delete Event
                </button>
            </form>

        </div>

    <% } %>

</div>

<h2 class="section-title">
    Event Gallery
</h2>

<% if(event.media && event.media.length > 0){ %>

    <div class="gallery">

        <% event.media.forEach(function(item){ %>

            <% if(item.url){ %>

                <% 
                const videoExtensions = ['.mp4','.webm','.ogg','.mov'];
                const isVideo = videoExtensions.some(ext =>
                    item.url.toLowerCase().endsWith(ext)
                );
                %>

                <a
                    href="/media/<%= item._id %>"
                    class="gallery-item"
                >

                    <% if(isVideo){ %>

                        <div class="video-badge">
                            ▶ Video
                        </div>

                        <video
                            src="<%= item.url %>"
                            muted
                            preload="metadata"
                        ></video>

                    <% } else { %>

                        <img
                            src="<%= item.url %>"
                            alt="Event Media"
                        >

                    <% } %>

                </a>

            <% } %>

        <% }) %>

    </div>

<% } else { %>

    <div class="empty">

        <h3>
            No Media Uploaded Yet
        </h3>

        <p>
            Upload photos and videos to start building this event gallery.
        </p>

    </div>

<% } %>

</div>

</div>

</body>
</html>