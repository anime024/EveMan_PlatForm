<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Dashboard</title>

<style>
    *{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:#f5f7fa;
    min-height:100vh;
}

/* Page Container */
.container{
    max-width:1200px;
    margin:30px auto;
    padding:0 20px;
}

/* Heading */
.page-title{
    color:#1e293b;
    margin-bottom:25px;
    font-size:32px;
}

/* Welcome Card */
.welcome-card{
    background:white;
    border-radius:18px;
    padding:28px;
    box-shadow:0 4px 15px rgba(0,0,0,0.08);
    margin-bottom:30px;
}

.welcome-card h3{
    color:#0f172a;
    margin-bottom:10px;
    font-size:24px;
}

.welcome-card p{
    color:#64748b;
    margin-bottom:6px;
}

/* Feature Cards */
.cards{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:20px;
}

.card{
    background:white;
    border-radius:18px;
    padding:25px;
    box-shadow:0 4px 15px rgba(0,0,0,0.08);
    transition:all 0.25s ease;
    border:1px solid #eef2f7;
}

.card:hover{
    transform:translateY(-5px);
    box-shadow:0 10px 25px rgba(0,0,0,0.12);
}

.card h3{
    color:#1e293b;
    margin-bottom:12px;
}

.card p{
    color:#64748b;
    line-height:1.5;
    margin-bottom:20px;
}

/* Buttons */
.btn{
    display:inline-block;
    text-decoration:none;
    background:#7c3aed;
    color:white;
    padding:10px 18px;
    border-radius:10px;
    font-weight:600;
    transition:0.2s;
}

.btn:hover{
    background:#6d28d9;
}

/* Statistics Section */
.stats{
    margin-top:35px;
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
}

.stat-card{
    background:white;
    border-radius:18px;
    padding:25px;
    text-align:center;
    box-shadow:0 4px 15px rgba(0,0,0,0.08);
    transition:0.2s;
}

.stat-card:hover{
    transform:translateY(-3px);
}

.stat-card h2{
    font-size:38px;
    color:#7c3aed;
    margin-bottom:10px;
}

.stat-card p{
    color:#64748b;
    font-weight:500;
}

/* Mobile */
@media(max-width:768px){

    .page-title{
        font-size:26px;
    }

    .welcome-card{
        padding:22px;
    }

    .card{
        padding:22px;
    }

    .stat-card h2{
        font-size:30px;
    }
}
</style>

</head>
<body>

        <%- include('../partials/navbar') %>
        <div class="container">

    <h1 class="page-title">
    Admin Dashboard
</h1>


    <div class="welcome-card">
        <h3>Welcome Admin</h3>
        <p>User ID: <%= user._id %></p>
        <p>Email: <%= user.email %></p>
    </div>

    <div class="cards">

        <div class="card">
            <h3>Manage Users</h3>
            <p>View, edit roles, ban or delete users.</p>

            <a href="/admin/users" class="btn">
                Open
            </a>
        </div>

        <div class="card">
            <h3>Manage Events</h3>
            <p>Create, edit and delete events.</p>

            <a href="/admin/events" class="btn">
                Open
            </a>
        </div>

        <div class="card">
            <h3>Manage Media</h3>
            <p>Review uploaded photos and videos.</p>

            <a href="/admin/allMedia" class="btn">
                Open
            </a>
        </div>

        

    </div>

    <div class="stats">

        <div class="stat-card">
            <h2><%= totalUsers || 0 %></h2>
            <p>Total Users</p>
        </div>

        <div class="stat-card">
            <h2><%= totalEvents || 0 %></h2>
            <p>Total Events</p>
        </div>

        <div class="stat-card">
            <h2><%= totalMedias || 0 %></h2>
            <p>Total Medias</p>
        </div>

        

    </div>

</div>

</body>
</html>