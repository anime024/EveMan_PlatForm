<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Dashboard</title>

    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:Arial, sans-serif;
        }

        body{
            background-color:#f4f4f4;
            display:flex;
            justify-content:center;
            align-items:center;
            height:100vh;
        }

        .dashboard{
            background:white;
            padding:30px;
            border-radius:10px;
            width:380px;
            text-align:center;
            box-shadow:0 0 10px rgba(0,0,0,0.1);
        }

        h1{
            margin-bottom:10px;
            color:#333;
        }

        h2{
            margin-bottom:15px;
            color:#444;
        }

        p{
            margin-bottom:10px;
            color:#666;
        }

        .btn{
            padding:10px 18px;
            border:none;
            color:white;
            border-radius:5px;
            cursor:pointer;
            font-size:15px;
            margin:8px;
            width:80%;
        }

        .logout-btn{ background:#e74c3c; }
        .logout-btn:hover{ background:#c0392b; }

        .photo-btn{ background:#3498db; }
        .photo-btn:hover{ background:#2c80b4; }

        .event-link{
            display:inline-block;
            margin-top:15px;
            color:#8b38f8;
            text-decoration:none;
            font-weight:bold;
        }

        .event-link:hover{
            text-decoration:underline;
        }
    </style>
</head>

<body>

    <div class="dashboard">

        <% if (message) { %>
            <h2><%= message %></h2>
        <% } %>

        <h1>Dashboard</h1>

        <p>Welcome <%= user.name %></p>
        <p>Email: <%= user.email %></p>
        
        <p>Role: <%= user.role %></p>
        <form action="/user/photographer" method="get">
            <button class="btn photo-btn" type="submit">
                Photographer Only Link
            </button>
        </form>

        <a class="event-link" href="/event">See Events</a>

        <br><br>

        <form action="/user/logout" method="get">
            <button class="btn logout-btn" type="submit">
                Logout
            </button>
        </form>

    </div>

</body>
</html>